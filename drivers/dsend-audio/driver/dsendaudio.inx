; dsend's own render endpoint: a root-enumerated virtual audio device with
; one speaker endpoint and no capture endpoint. Derived from Microsoft's
; Windows-driver-samples audio/simpleaudiosample (MS-PL, see ../LICENSE).

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 11/11/2026, 1.0.0.0
CatalogFile = dsendaudio.cat
PnpLockDown = 1

[SourceDisksNames]
222="dsend Driver Disk","",222

[SourceDisksFiles]
dsendaudio.sys=222

[SignatureAttributes]
dsendaudio.sys=SignatureAttributes.DRM

[SignatureAttributes.DRM]
DRMLevel=1300

[SignatureAttributes.PETrust]
PETrust=true

; Windows 10 2004 (build 19041) and later: the driver uses ExAllocatePool2.
[Manufacturer]
%MfgName%=DSEND,NT$ARCH$.10.0...19041

[DSEND.NT$ARCH$.10.0...19041]
%DSEND_SA.DeviceDesc%=DSEND_SA, ROOT\dsend_audio

[DestinationDirs]
DSEND_SA.CopyList=13 ; 13=Package's DriverStore directory

;======================================================
; DSEND_SA
;======================================================
[DSEND_SA.CopyList]
dsendaudio.sys

[DSEND_SA.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,dsendaudio.sys

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%DSEND_SA.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DSEND_SA.DeviceDesc%

;======================================================
; render interfaces: speaker (the only endpoint)
;======================================================
[DSEND.I.WaveSpeaker]
AddReg=DSEND.I.WaveSpeaker.AddReg

[DSEND.I.WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%DSEND.WaveSpeaker.szPname%

[DSEND.I.TopologySpeaker]
AddReg=DSEND.I.TopologySpeaker.AddReg

[DSEND.I.TopologySpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%DSEND.TopologySpeaker.szPname%

HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

; The following lines opt-in to pull mode.
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================
; DSEND_SA
;======================================================
[DSEND_SA.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=DSEND_SA.CopyList
AddReg=DSEND_SA.AddReg

[DSEND_SA.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveSpeaker%, DSEND.I.WaveSpeaker
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveSpeaker%, DSEND.I.WaveSpeaker
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%, DSEND.I.WaveSpeaker
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologySpeaker%, DSEND.I.TopologySpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, DSEND.I.TopologySpeaker

[DSEND_SA.NT.Services]
AddService=dsendaudio,0x00000002,dsendaudio_Service_Inst

[dsendaudio_Service_Inst]
DisplayName=%dsendaudio.SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\dsendaudio.sys

[DSEND_SA.NT.HW]
AddReg = AUDIOHW.AddReg

[AUDIOHW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

;======================================================
; COMMON
;======================================================
[Strings]

;Non-localizable

KSNAME_WaveSpeaker="WaveSpeaker"
KSNAME_TopologySpeaker="TopologySpeaker"

Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME ="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"

KSNODETYPE_ANY   = "{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_Association               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

;Localizable

ProviderName = "dstack"
MfgName      = "dstack"

DSEND_SA.DeviceDesc="dsend"
dsendaudio.SvcDesc="dsend virtual audio output"

;; friendly names
DSEND.WaveSpeaker.szPname="dsend"
DSEND.TopologySpeaker.szPname="dsend"
